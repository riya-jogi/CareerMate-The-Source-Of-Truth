# ==============================================================================
# CareerMate Backend Environment Configuration Example
# Copy this file to .env and adjust variables for your local setup.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="CareerMate - ATS & Resume Optimization Platform"
VERSION=0.1.0
API_V1_STR=/api/v1

# PostgreSQL Database Connection
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:Postgres%40123@localhost:5432/careermate_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=True

# JWT Authentication & Security
# WARNING: Generate a secure random key for production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=careermate-dev-super-secret-key-replace-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=careermate_refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Frontend CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
